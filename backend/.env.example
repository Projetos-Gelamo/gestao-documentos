# Supabase
SUPABASE_URL=https://seu-projeto.supabase.co
SUPABASE_SERVICE_ROLE_KEY=sua-service-role-key-aqui

# Frontend (Next.js — copiar para frontend/.env.local)
NEXT_PUBLIC_SUPABASE_URL=https://seu-projeto.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sua-anon-key-aqui

# Google Drive (JSON da conta de serviço, em uma única linha)
GOOGLE_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"...","private_key_id":"...","private_key":"...","client_email":"...","client_id":"...","auth_uri":"https://accounts.google.com/o/oauth2/auth","token_uri":"https://oauth2.googleapis.com/token"}

# Classificador de IA: claude | openai | gemini
CLASSIFIER_PROVIDER=claude
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=
CLASSIFIER_CONFIDENCE_THRESHOLD=0.7

# Monitor do Drive
DRIVE_POLL_INTERVAL_MINUTES=2

# E-mail: resend | smtp
EMAIL_PROVIDER=resend
EMAIL_API_KEY=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=relatorios@seuescritorio.com.br

# Relatório diário (cron — padrão: 7h dias úteis)
DAILY_REPORT_CRON=0 7 * * 1-5
